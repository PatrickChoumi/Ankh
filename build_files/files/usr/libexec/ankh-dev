#!/usr/bin/bash
# Crée, met à jour ou supprime le conteneur de dev (D-032), seulement quand je le
# décide (D-031) : la création se fait au premier lancement de VS Code depuis
# le menu (D-036, /usr/libexec/ankh-vscode), la mise à jour par l'entrée
# « Mettre à jour les outils de dev ».
set -euo pipefail

case "${1:-}" in
    creer)
        # Tout ce qui s'affiche est aussi gardé dans un journal, pour
        # comprendre un échec après coup.
        journal="${XDG_CACHE_HOME:-${HOME}/.cache}/ankh/preparation-dev.log"
        mkdir -p "$(dirname "${journal}")"
        exec > >(tee "${journal}") 2>&1
        echo "Journal : ${journal}"
        echo "Préparation de l'environnement de dev : VS Code, Java, Python, JavaScript,"
        echo "C/C++ et bases de données. Gros téléchargement, seulement cette fois-ci."
        echo
        distrobox assemble create --file /usr/share/ankh/distrobox.ini
        distrobox enter ankh-dev -- /usr/libexec/ankh-dev-setup
        echo "Terminé. VS Code va s'ouvrir."
        ;;
    mettre-a-jour)
        if ! podman container exists ankh-dev; then
            echo "Les outils de dev ne sont pas encore préparés : ouvrez VS Code une première fois depuis le menu." >&2
            exit 1
        fi
        distrobox upgrade ankh-dev
        echo "Terminé. Cette fenêtre peut être fermée."
        ;;
    supprimer)
        # Option Dev retirée (D-046) : le conteneur et son image partent ; le
        # dossier personnel, partagé avec le conteneur, reste tel quel.
        if podman container exists ankh-dev; then
            podman rm --force ankh-dev
        fi
        image="$(sed -n 's/^image=//p' /usr/share/ankh/distrobox.ini)"
        if podman image exists "${image}"; then
            podman image rm "${image}"
        fi
        ;;
    *)
        echo "Usage : ankh-dev creer | mettre-a-jour | supprimer" >&2
        exit 2
        ;;
esac
