[Desktop Entry]
Type=Application
Name=LightCraft
GenericName=Photothèque et développement RAW
Comment=Ranger ses photos et développer ses fichiers RAW, sans jamais toucher à l'original. Suite Craft, dans l'option Création d'Ankh : se prépare au premier lancement (téléchargement depuis GitHub, une seule fois).
Exec=/usr/libexec/ankh-craft ai.storyteller.lightcraft %F
Icon=ai.storyteller.lightcraft
Terminal=false
StartupWMClass=ai.storyteller.lightcraft
Categories=Graphics;2DGraphics;RasterGraphics;Photography;
Keywords=photo;raw;appareil photo;photothèque;développement;lightroom;camera;library;develop;
MimeType=image/heic;image/heif;image/jpeg;image/png;image/tiff;image/webp;image/x-adobe-dng;image/x-sony-arw;image/x-canon-cr2;image/x-canon-cr3;image/x-nikon-nef;image/x-fuji-raf;image/x-olympus-orf;image/x-panasonic-rw2;image/x-panasonic-rw;image/x-pentax-pef;
