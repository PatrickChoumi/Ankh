[Desktop Entry]
Type=Application
Name=WordCraft
GenericName=Traitement de texte
Comment=Écrire et mettre en page des documents ; ouvrir et enregistrer des fichiers Word. Suite Craft, dans l'image d'Ankh : se prépare au premier lancement (téléchargement depuis GitHub, une seule fois).
Exec=/usr/libexec/ankh-craft ai.storyteller.wordcraft %F
Icon=ai.storyteller.wordcraft
Terminal=false
StartupWMClass=ai.storyteller.wordcraft
Categories=Office;WordProcessor;
Keywords=texte;lettre;rapport;traitement de texte;word;processor;document;docx;writer;text;letter;report;
MimeType=application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/vnd.ms-word.document.macroEnabled.12;application/vnd.openxmlformats-officedocument.wordprocessingml.template;application/vnd.ms-word.template.macroEnabled.12;application/msword;application/msword-template;application/vnd.oasis.opendocument.text;application/rtf;text/rtf;text/markdown;text/x-tex;text/html;text/plain;
