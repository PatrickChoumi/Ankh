# Couleurs du terminal Konsole pour Ankh (D-037), validées sur les aperçus en
# VM : fond du logo (#0d1117), texte du logo (#e6edf3), violet d'Ankh pour le
# magenta. Fond légèrement translucide et flouté, comme le terminal de macOS
# (D-039 ; clés « Opacity » et « Blur » de src/colorscheme/ColorScheme.cpp,
# https://invent.kde.org/utilities/konsole).

[General]
Blur=true
Description=Ankh
Opacity=0.92

[Background]
Color=13,17,23

[BackgroundIntense]
Color=22,27,34

[Foreground]
Color=230,237,243

[ForegroundIntense]
Color=255,255,255

[Color0]
Color=72,79,88

[Color0Intense]
Color=110,118,129

[Color1]
Color=255,123,114

[Color1Intense]
Color=255,161,152

[Color2]
Color=63,185,80

[Color2Intense]
Color=86,211,100

[Color3]
Color=210,153,34

[Color3Intense]
Color=227,179,65

[Color4]
Color=88,166,255

[Color4Intense]
Color=121,192,255

