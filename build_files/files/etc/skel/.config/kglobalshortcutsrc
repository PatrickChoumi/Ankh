# Raccourcis globaux des nouveaux comptes d'Ankh (D-052, lot 7b), lus par
# kglobalacceld (« touches actives, touches par défaut, nom »). Windows+Tab
# ouvre la vue des tâches d'Ankh ; Alt+Tab garde Alt, sans Meta+Tab, que KWin
# lui donne aussi (src/tabbox/tabbox.cpp). Un raccourci déjà écrit ici garde
# ses touches quand son programme l'enregistre (setShortcutKeys,
# src/kglobalacceld.cpp de kglobalacceld 6.7).
[kwin]
_k_friendly_name=KWin
AnkhVueTaches=Meta+Tab,none,Vue des tâches
Walk Through Windows=Alt+Tab,Alt+Tab\tMeta+Tab,Walk Through Windows
Walk Through Windows (Reverse)=Alt+Shift+Tab,Alt+Shift+Tab\tMeta+Shift+Tab,Walk Through Windows (Reverse)
